{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROS2: Debug (colcon)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/install/${input:pkgName}/lib/${input:pkgName}/${input:execName}",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "inputs": [
    {
      "id": "pkgName",
      "type": "promptString",
      "description": "Nome do pacote ROS2"
    },
    {
      "id": "execName",
      "type": "promptString",
      "description": "Nome do executável"
    }
  ]
}